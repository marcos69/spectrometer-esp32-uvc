CONFIG_IDF_TARGET="esp32s3"
# CPU + PSRAM (8MB octal part on the YD board)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=8192
# cam task legitimately saturates core 1 (JPEG decode workload):
# don't watchdog IDLE1 there — CPU0 stays watched
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 8MB flash board — custom partition table
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# UVC: print the full configuration descriptor on first camera connection
CONFIG_UVC_PRINTF_CONFIGURATION_DESCRIPTOR=y
# USB host: match the working basic_uvc_stream example's settings
# 4096-byte control buffer — CRITICAL: with the default 256, enumeration
# FAILS for cameras whose config descriptor is longer (enum.c rejects devices
# with wTotalLength > max — symptom: "0 devices" with no other hint)
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
CONFIG_USB_HOST_HW_BUFFER_BIAS_IN=y
# hubs off by default in IDF — the example enables them
CONFIG_USB_HOST_HUBS_SUPPORTED=y
